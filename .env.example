# Настройки подключения Telegram-бота Pharmojelly

# Токен основного бота (если не задан в 3jly.py)
# BOT_TOKEN=9223853959:AAGnEmmssJrArVQvygb_00_QrnME9DeRasg

# Прокси (если используется локальный прокси V2Ray/Xray/Clash/Tor/Socks5/HTTP)
# Например:
# PROXY_URL=http://127.0.0.1:10809
# PROXY_URL=socks5://127.0.0.1:10808

# Reverse-proxy зеркало для Telegram Bot API (например Cloudflare Worker или свой сервер)
# BASE_URL=https://<your-worker>.workers.dev/bot
